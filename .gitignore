# Dependencias
node_modules/
apps/web/node_modules/
apps/api/node_modules/

# Builds e saidas geradas
dist/
build/
apps/web/dist/
apps/api/dist/
.vite/

# Arquivos de ambiente sensiveis
.env
.env.local
.env.development
.env.production
apps/api/.env
apps/api/.env.local
apps/web/.env
apps/web/.env.local

# Manter exemplos de ambiente versionados
!.env.example
!apps/api/.env.example
!apps/web/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.turbo/
.eslintcache

# Coverage/testes
coverage/

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# VS Code local
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Banco, dumps e backups locais
database/backups/*
!database/backups/.gitkeep
*.sql.gz
*.dump
*.backup

# Uploads/arquivos locais do usuario
uploads/
storage/
tmp/
temp/

# Docker local/volumes, caso existam pastas mapeadas
mysql_data/
docker-data/

# Arquivos de certificados/chaves
*.pem
*.key
*.crt
